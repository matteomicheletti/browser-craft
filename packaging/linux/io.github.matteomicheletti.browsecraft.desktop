[Desktop Entry]
Type=Application
Name=BrowseCraft
GenericName=Web Browser
Comment=Lightweight Rust web browser
Exec=browsecraft %u
Icon=io.github.matteomicheletti.browsecraft
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=io.github.matteomicheletti.browsecraft
StartupNotify=true
